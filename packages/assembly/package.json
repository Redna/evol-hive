{
  "name": "@evol-hive/assembly",
  "version": "0.1.0",
  "private": true,
  "description": "Composition root (spec 050) — assembles the engine core and the cognition stack in one fully-wired call. The only package allowed to depend on both @evol-hive/engine and @evol-hive/cognition (ADR-0001: the two never import each other).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@evol-hive/cognition": "workspace:*",
    "@evol-hive/engine": "workspace:*",
    "@evol-hive/memory": "workspace:*",
    "@evol-hive/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}