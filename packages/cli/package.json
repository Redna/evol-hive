{
  "name": "@evol-hive/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command-line interface for evol-hive — create, validate, and run scenes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evol-hive": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@evol-hive/cognition": "workspace:*",
    "@evol-hive/engine": "workspace:*",
    "@evol-hive/memory": "workspace:*",
    "@evol-hive/shared": "workspace:*",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}