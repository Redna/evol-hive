# =============================================================================
# evol-hive — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values:  cp .env.example .env

# --- LLM Backend -------------------------------------------------------------
# The local LLM provider for agent cognition (System 2)
# Options: "ollama" | "llamacpp" | "vllm"
LLM_PROVIDER=ollama

# LLM endpoint URL
LLM_BASE_URL=http://localhost:11434

# Model name for the primary cognitive LLM (System 2)
LLM_MODEL=qwen2.5:14b

# Model name for the reflection/consolidation background LLM
LLM_REFLECTION_MODEL=qwen2.5:14b

# Maximum tokens for LLM responses
LLM_MAX_TOKENS=2048

# Temperature for LLM generation (lower = more deterministic)
LLM_TEMPERATURE=0.7

# --- Embedding Model (System 0 Classifier) ----------------------------------
# The lightweight embedding model for affordance pruning
# Options: "model2vec" | "onnx" | "ollama-embeddings"
EMBEDDING_PROVIDER=ollama-embeddings

# Embedding model name
EMBEDDING_MODEL=nomic-embed-text

# Embedding endpoint (if different from LLM_BASE_URL)
EMBEDDING_BASE_URL=http://localhost:11434

# Top-K affordances to retain after pruning
CLASSIFIER_TOP_K=5

# Cosine similarity threshold for pruning
CLASSIFIER_SIMILARITY_THRESHOLD=0.3

# --- Memory (Vector Store) --------------------------------------------------
# Vector database backend
# Options: "lancedb" | "chromadb" | "in-memory"
MEMORY_BACKEND=in-memory

# Path to vector store data (if file-based)
MEMORY_DATA_PATH=./data/memory

# Short-term memory buffer threshold before triggering reflection
MEMORY_REFLECTION_THRESHOLD=50

# --- Engine Configuration ---------------------------------------------------
# Target simulation FPS
ENGINE_FPS=60

# Spatial debounce: seconds of idleness before triggering a perception tick
ENGINE_SPATIAL_DEBOUNCE_SECONDS=5

# Maximum concurrent agent LLM calls
ENGINE_MAX_CONCURRENT_LLM=8

# Enable cognitive guardrails
ENGINE_GUARDRAILS_ENABLED=true

# --- Logging ----------------------------------------------------------------
# Log level: "trace" | "debug" | "info" | "warn" | "error"
LOG_LEVEL=info